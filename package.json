{
  "name": "veridun",
  "version": "0.1.0",
  "private": true,
  "description": "Auditable Proof Gatekeeper agent for zkVerify Agent Games",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:vercel": "npm run circuit:prepare && npm run build:web",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:proof": "vitest run tests/prover.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "circuit:prepare": "node scripts/prepare-circuit.mjs",
    "circuit:verify": "node scripts/verify-circuit.mjs",
    "circuit:info": "node scripts/circuit-info.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@polkadot/api": "^17.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "js-sha3": "^0.14.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "snarkjs": "^0.7.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
