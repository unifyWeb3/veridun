{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/web",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "framework": "vite",
  "functions": {
    "api/**": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "artifacts/circuit/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With,Content-Type,X-Agent-Games-Signature" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/agent", "destination": "/api/agent" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/dashboard/summary", "destination": "/api/summary" },
    { "source": "/api/tasks/:taskId", "destination": "/api/task?task_id=:taskId" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}
