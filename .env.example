# Agent Games dashboard → Rotate Secret. Required in production.
AGENT_GAMES_HMAC_SECRET=

# PostgreSQL connection. Use a persistent, non-sleeping production database.
DATABASE_URL=postgres://veridun:veridun@localhost:5432/veridun

# kurier.xyz mainnet API key. Required for public finalization evidence.
KURIER_API_KEY=
KURIER_API_BASE_URL=https://api.kurier.xyz/api/v1

# Circuit artifacts are downloaded and checksum-verified by npm run circuit:prepare.
CIRCUIT_DIR=artifacts/circuit

# auto | hex-suffix | sha256 | keccak256
TASK_ID_ENCODING=auto

# subscan checks the public finalized extrinsic page. trusted-payload is local-test only.
INBOUND_PROOF_VERIFIER=zkverify
SUBSCAN_BASE_URL=https://zkverify.subscan.io
ZKVERIFY_RPC_URL=https://zkverify-rpc.zkverify.io

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DASHBOARD_ENABLED=true
PROOF_SUBMIT_ENABLED=true
KURIER_POLL_INTERVAL_MS=2000
KURIER_FINALITY_TIMEOUT_MS=30000
REQUEST_BUDGET_MS=55000
MAX_REQUEST_BYTES=1048576
